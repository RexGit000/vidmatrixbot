BOT_TOKEN=
MONGODB_URI=
DB_NAME=
PORT=

# Per-update handler timeout (default: 0 = infinite).
# Telegraf ships with 90000ms (90s) default which kills gifting packages > ~50 items.
# Set to 0 for infinite; or set to e.g. HANDLER_TIMEOUT_MS=1200000 for 20 min cap.
# HANDLER_TIMEOUT_MS=0

# GramJS (userbot) credentials. Obtain at my.telegram.org.
# Both are required for the 🤖 Userbot Login scene to work.
API_ID=
API_HASH=

# Optional: override the per-bot cache key for bot_file_ids slots.
# Defaults to the numeric prefix before the first ":" in BOT_TOKEN.
# CURRENT_BOT_KEY=
